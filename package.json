{
  "name": "@ebinas/react-use-minesweeper",
  "description": "A deterministic Minesweeper engine and React hook",
  "version": "2.0.0",
  "license": "MIT",
  "author": "ebinas",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "minesweeper",
    "hook",
    "game"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ebinase/react-use-minesweeper.git"
  },
  "homepage": "https://github.com/ebinase/react-use-minesweeper#readme",
  "bugs": {
    "url": "https://github.com/ebinase/react-use-minesweeper/issues/new/choose"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "format": "prettier --write --ignore-path .gitignore './**/*.{js,cjs,mjs,jsx,ts,tsx,json,css}'",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "prepack": "npm run build",
    "check:package": "npm run build && node scripts/check-package.cjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/react": "18.2.20",
    "@types/react-test-renderer": "^18.3.1",
    "eslint": "8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.6.4",
    "prettier": "^3.0.2",
    "react": "18.2.0",
    "react-test-renderer": "^18.2.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "5.1.6"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "type": "module"
}
