{
  "compilerOptions": {
    "target": "es2018",
    "module": "nodenext",
    "lib": ["es2018"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["react"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "tests", "dist"]
}
